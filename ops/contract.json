{
  "schema": "fichaje.ops.contract",
  "version": 1,
  "description": "OPS-02 single source of truth for operational events, metrics, alerts and retries. Every value that can reach a log line, metric label or alert is enumerated here: nothing personal, laboral or secret fits in it.",
  "components": ["web", "kiosk-gateway", "export-link", "export-worker", "retention-worker", "recovery-journal", "health", "canary", "invariants", "projection-rebuild", "alerts", "release-gate", "backup-monitor", "fault-injection", "ops-suite"],
  "operations": [
    "clock.CLOCK_IN", "clock.BREAK_START", "clock.BREAK_END", "clock.CLOCK_OUT",
    "kiosk.authenticate", "kiosk.clock.CLOCK_IN", "kiosk.clock.BREAK_START", "kiosk.clock.BREAK_END", "kiosk.clock.CLOCK_OUT",
    "kiosk.provision", "kiosk.revoke", "kiosk.reset", "export.link", "auth.sign_in", "select",
    "rpc.get_employee_state", "rpc.get_effective_timeline", "rpc.get_own_evidence", "rpc.submit_correction", "rpc.decide_correction",
    "rpc.request_export", "rpc.manage_employee", "rpc.manage_membership", "rpc.transfer_ownership", "rpc.create_invitation",
    "rpc.accept_invitation", "rpc.create_work_policy", "rpc.assign_work_policy", "rpc.classify_hours",
    "rpc.record_evidence_delivery", "rpc.authorize_export_link", "rpc.other",
    "request.rejected", "health.live", "health.ready",
    "job.export", "job.retention", "job.recovery_journal", "journal.check",
    "probe.app", "probe.api", "probe.auth", "probe.postgres", "probe.kiosk_gateway", "probe.export_link", "health.aggregate",
    "canary.run", "canary.provision", "canary.rotate", "canary.verify",
    "invariants.check", "invariants.record", "projection.check", "projection.rebuild",
    "backup.repo", "backup.database",
    "release.build", "release.deploy", "release.gate", "release.promote", "release.rollback",
    "alert.evaluate", "alert.notify", "fault.inject", "fault.clear", "suite.step"
  ],
  "outcomes": ["success", "failure", "timeout", "unknown", "rejected", "degraded", "skipped"],
  "error_classes": [
    "NONE", "VERSION_CONFLICT", "IDEMPOTENCY_CONFLICT", "ALREADY_DECIDED", "CLOCK_REGRESSION", "POLICY_REQUIRED",
    "INVALID_TRANSITION", "INVALID_INPUT", "INVALID_TIMEZONE", "INVALID_TIMELINE", "INVALID_ORDINAL", "FUTURE_TIME",
    "POLICY_BACKDATE", "HOURS_MISMATCH", "INCOMPLETE_PERIOD", "LAST_OWNER", "FORBIDDEN", "UNAUTHENTICATED",
    "AUTH_FAILED", "RATE_LIMITED", "TIMEOUT", "NETWORK", "UPSTREAM_5XX", "RETRYABLE_TIMEOUT", "INVALID_RESPONSE",
    "UNKNOWN_OUTCOME", "DB_UNAVAILABLE", "AUTH_UNAVAILABLE", "STORAGE_ERROR", "EXPORT_VERIFY_FAILED", "EXPORT_EXPIRED",
    "JOURNAL_UNAVAILABLE", "JOURNAL_UNRESOLVED", "JOURNAL_MISMATCH", "LEGAL_HOLD", "CONFIG", "CIRCUIT_OPEN",
    "RETRY_EXHAUSTED", "NOT_RETRYABLE", "ASSERTION", "DEGRADED", "INTERNAL"
  ],
  "levels": ["info", "warn", "error"],
  "states": ["UP", "DEGRADED", "DOWN", "PASS", "FAIL", "OK", "STALE", "FAILED", "MISSING", "UNVERIFIED", "NOT_CONFIGURED", "UNKNOWN",
    "APPLIED", "NOOP", "BLOCKED", "MATCH", "DRIFT", "PURGED", "FIRING", "RESOLVED", "HEALTHY", "ROLLED_BACK", "NO_ROLLBACK", "PROMOTED", "VERIFIED"],
  "checks": ["app", "api", "auth", "postgres", "kiosk_gateway", "export_link"],
  "critical_checks": ["app", "api", "auth", "postgres", "kiosk_gateway"],
  "channels": ["web", "kiosk"],
  "actions": ["CLOCK_IN", "BREAK_START", "BREAK_END", "CLOCK_OUT"],
  "jobs": ["export", "retention", "recovery_journal"],
  "backup_kinds": ["repo", "database"],
  "severities": ["CRITICAL", "WARNING", "INFO"],
  "environments": ["ci", "local", "staging", "production"],
  "invariants": ["IMMUTABILITY_GUARD", "FOREIGN_KEY_VALIDATED", "PROJECTION_DRIFT", "HISTORY_PURGED", "TIMELINE_VALID", "SEQUENCE_CONTIGUOUS",
    "VERSION_HIGH_WATER", "EVENT_AUDIT", "EVENT_RECEIPT", "ORIGINAL_IMMUTABLE", "TENANT_REFERENCE", "CORRECTION_COHERENCE",
    "OPEN_SESSION_STALE", "OPEN_SESSIONS", "AUDIT_WITHOUT_EVENT", "RECEIPT_WITHOUT_EVENT", "CORRECTION_AUDIT",
    "MANIFEST_COHERENCE", "JOURNAL_OUTBOX", "EXPORT_JOB_STATE", "RETENTION_OVERDUE"],
  "event_fields": {
    "ts": "timestamp", "level": "levels", "release": "release", "commit": "commit", "component": "components",
    "operation": "operations", "outcome": "outcomes", "error_class": "error_classes", "request_id": "uuid",
    "run_id": "uuid", "duration_ms": "number", "delay_ms": "number", "attempt": "integer", "count": "integer",
    "status": "http_status", "stage": "code", "check": "checks", "state": "states", "channel": "channels",
    "action": "actions", "job": "jobs", "kind": "backup_kinds", "severity": "severities", "invariant": "invariants",
    "alert": "alert_names", "release_id": "release", "environment": "environments"
  },
  "required_event_fields": ["ts", "level", "release", "commit", "component", "operation", "outcome"],
  "forbidden_keys": ["jwt", "token", "access_token", "refresh_token", "authorization", "apikey", "api_key", "service_key", "secret",
    "password", "pepper", "pin", "challenge", "email", "name", "display_name", "code", "employee_code", "reason", "motivo",
    "payload", "body", "proposal", "snapshot", "signed_url", "url", "employee_id", "event_id", "session_id", "membership_id",
    "user_id", "auth_user_id", "organization_id", "tenant", "ip", "address", "sql", "query", "stack", "traceback",
    "exception", "message", "detail", "hint"],
  "duration_buckets_ms": [50, 100, 250, 500, 1000, 2500, 5000, 10000, 30000],
  "metrics": {
    "fichaje_ops_events_total": {"type": "counter", "help": "Operational events by component, operation, outcome and stable error class", "labels": {"component": "components", "operation": "operations", "outcome": "outcomes", "error_class": "error_classes"}},
    "fichaje_ops_duration_ms": {"type": "histogram", "help": "Operation latency in milliseconds", "labels": {"component": "components", "operation": "operations"}},
    "fichaje_frontend_requests_total": {"type": "counter", "trust": "untrusted", "help": "Browser API requests aggregated by the client (no identity; untrusted: never an alert, gate or repair input)", "labels": {"operation": "operations", "outcome": "outcomes", "error_class": "error_classes"}},
    "fichaje_frontend_duration_ms": {"type": "histogram", "trust": "untrusted", "help": "Browser API latency in milliseconds (untrusted: never an alert, gate or repair input)", "labels": {"operation": "operations"}},
    "fichaje_probe_up": {"type": "gauge", "help": "1 UP, 0.5 DEGRADED, 0 DOWN", "labels": {"check": "checks"}},
    "fichaje_probe_latency_ms": {"type": "gauge", "help": "Latency of the last health probe", "labels": {"check": "checks"}},
    "fichaje_canary_success": {"type": "gauge", "help": "1 when the last synthetic cycle passed", "labels": {"channel": "channels"}},
    "fichaje_invariant_findings": {"type": "gauge", "help": "Findings of the last read-only invariant run", "labels": {"invariant": "invariants", "severity": "severities"}},
    "fichaje_backup_age_seconds": {"type": "gauge", "help": "Age of the last verified backup", "labels": {"kind": "backup_kinds"}},
    "fichaje_backup_ok": {"type": "gauge", "help": "1 only for a fresh, successful, verified backup; 0 for anything else, including NOT_CONFIGURED", "labels": {"kind": "backup_kinds"}},
    "fichaje_job_last_run_success": {"type": "gauge", "help": "1 when the last job run succeeded", "labels": {"job": "jobs"}},
    "fichaje_db_connections_used_ratio": {"type": "gauge", "help": "Connections in use over max_connections", "labels": {}},
    "fichaje_db_lock_waiting": {"type": "gauge", "help": "Lock requests currently waiting", "labels": {}},
    "fichaje_db_deadlocks_total": {"type": "counter", "help": "Deadlocks reported by PostgreSQL for this database", "labels": {}},
    "fichaje_alerts_firing": {"type": "gauge", "help": "Alerts currently firing", "labels": {"alert": "alert_names", "severity": "severities"}}
  },
  "forbidden_label_keys": ["employee_id", "event_id", "request_id", "session_id", "email", "user", "user_id", "tenant", "organization_id", "org", "device_id", "name", "code", "ip", "token"],
  "alerts": {
    "APP_DOWN": {"severity": "CRITICAL", "source": "health", "summary": "La aplicación web no se sirve completa", "runbook": "docs/RUNBOOKS.md#api-down"},
    "API_DOWN": {"severity": "CRITICAL", "source": "health", "summary": "API (PostgREST) indisponible", "runbook": "docs/RUNBOOKS.md#api-down"},
    "AUTH_DOWN": {"severity": "CRITICAL", "source": "health", "summary": "Supabase Auth indisponible", "runbook": "docs/RUNBOOKS.md#auth-down"},
    "POSTGRES_DOWN": {"severity": "CRITICAL", "source": "health", "summary": "PostgreSQL indisponible", "runbook": "docs/RUNBOOKS.md#postgres-down"},
    "KIOSK_GATEWAY_DOWN": {"severity": "CRITICAL", "source": "health", "summary": "Gateway del kiosco indisponible", "runbook": "docs/RUNBOOKS.md#kiosk-gateway-down"},
    "EXPORT_LINK_DOWN": {"severity": "WARNING", "source": "health", "summary": "Firmador de enlaces de exportación indisponible", "runbook": "docs/RUNBOOKS.md#export-worker-failure"},
    "LATENCY_HIGH": {"severity": "WARNING", "source": "health", "summary": "Latencia elevada en una dependencia", "runbook": "docs/RUNBOOKS.md#api-down"},
    "DB_SATURATION": {"severity": "WARNING", "source": "health", "summary": "PostgreSQL cerca de saturación de conexiones o con esperas de lock", "runbook": "docs/RUNBOOKS.md#postgres-down"},
    "CANARY_FAILED": {"severity": "CRITICAL", "source": "canary", "summary": "Canary sintético de fichaje roto", "runbook": "docs/RUNBOOKS.md#canary-failure"},
    "INVARIANT_CRITICAL": {"severity": "CRITICAL", "source": "invariants", "summary": "Invariante crítica violada: revisión humana, sin reparación automática de historia", "runbook": "docs/RUNBOOKS.md#invariant-drift"},
    "INVARIANT_WARNING": {"severity": "WARNING", "source": "invariants", "summary": "Invariante de aviso (sesiones abiertas antiguas u otra señal)", "runbook": "docs/RUNBOOKS.md#invariant-drift"},
    "EXPORT_BACKLOG": {"severity": "WARNING", "source": "invariants", "summary": "Exportaciones pendientes o caducadas sin procesar", "runbook": "docs/RUNBOOKS.md#export-worker-failure"},
    "RETENTION_OVERDUE": {"severity": "WARNING", "source": "invariants", "summary": "Datos operativos caducados pendientes de purga", "runbook": "docs/RUNBOOKS.md#retention-worker-failure"},
    "BACKUP_MISSING": {"severity": "CRITICAL", "source": "backup", "summary": "Backup ausente", "runbook": "docs/RUNBOOKS.md#backup-stale-failure"},
    "BACKUP_FAILED": {"severity": "CRITICAL", "source": "backup", "summary": "Último backup fallido", "runbook": "docs/RUNBOOKS.md#backup-stale-failure"},
    "BACKUP_STALE": {"severity": "CRITICAL", "source": "backup", "summary": "Backup demasiado antiguo", "runbook": "docs/RUNBOOKS.md#backup-stale-failure"},
    "BACKUP_UNVERIFIED": {"severity": "CRITICAL", "source": "backup", "summary": "Backup sin verificación válida", "runbook": "docs/RUNBOOKS.md#backup-stale-failure"},
    "BACKUP_NEAR_STALE": {"severity": "WARNING", "source": "backup", "summary": "Backup cerca del umbral de frescura", "runbook": "docs/RUNBOOKS.md#backup-stale-failure"},
    "DB_BACKUP_NOT_CONFIGURED": {"severity": "WARNING", "production_severity": "CRITICAL", "source": "backup", "summary": "Backup PostgreSQL no configurado (bloqueado hasta H7): nunca verde", "runbook": "docs/RUNBOOKS.md#backup-stale-failure"},
    "JOB_FAILED": {"severity": "WARNING", "source": "jobs", "summary": "Job operativo fallido", "runbook": "docs/RUNBOOKS.md#export-worker-failure", "runbook_by_label": {"job": {"export": "docs/RUNBOOKS.md#export-worker-failure", "retention": "docs/RUNBOOKS.md#retention-worker-failure", "recovery_journal": "docs/RUNBOOKS.md#recovery-journal-unresolved"}}},
    "RETRY_REPEATED": {"severity": "WARNING", "source": "jobs", "summary": "Reintentos repetidos de una operación idempotente", "runbook": "docs/RUNBOOKS.md#api-down"},
    "RECOVERY_JOURNAL_BLOCKED": {"severity": "CRITICAL", "source": "journal", "summary": "Recovery journal bloqueado o incoherente", "runbook": "docs/RUNBOOKS.md#recovery-journal-unresolved"},
    "ERROR_RATE_HIGH": {"severity": "WARNING", "source": "metrics", "summary": "Aumento de errores", "runbook": "docs/RUNBOOKS.md#api-down"},
    "SLOW_OPERATIONS": {"severity": "WARNING", "source": "metrics", "summary": "Latencia p95 elevada en operaciones", "runbook": "docs/RUNBOOKS.md#api-down"},
    "VERSION_CONFLICT_HIGH": {"severity": "WARNING", "source": "metrics", "summary": "VERSION_CONFLICT anormalmente alto", "runbook": "docs/RUNBOOKS.md#clock-regression"},
    "CLOCK_REGRESSION": {"severity": "WARNING", "source": "metrics", "summary": "CLOCK_REGRESSION observado: reloj del servidor por detrás de la marca de agua", "runbook": "docs/RUNBOOKS.md#clock-regression"},
    "RELEASE_DEGRADED": {"severity": "WARNING", "source": "release", "summary": "Release candidata degradada: promoción detenida y rollback en curso", "runbook": "docs/RUNBOOKS.md#release-degraded"},
    "RELEASE_DEGRADED_NO_ROLLBACK": {"severity": "CRITICAL", "source": "release", "summary": "Release degradada sin rollback exitoso", "runbook": "docs/RUNBOOKS.md#release-degraded"},
    "KIOSK_AUTH_ABUSE": {"severity": "WARNING", "source": "metrics", "summary": "Rechazos repetidos de PIN o bloqueo por límite en el kiosco (posible credencial de dispositivo comprometida)", "runbook": "docs/RUNBOOKS.md#kiosk-auth-abuse"}
  },
  "alert_labels": {"check": "checks", "channel": "channels", "invariant": "invariants", "job": "jobs", "kind": "backup_kinds", "component": "components", "operation": "operations", "error_class": "error_classes", "state": "states"},
  "routes": {"CRITICAL": ["pager"], "WARNING": ["ticket"]},
  "thresholds": {
    "probe_timeout_ms": 5000,
    "latency_degraded_ms": 1000,
    "db_connections_warning_ratio": 0.8,
    "db_lock_waiting_warning": 20,
    "error_rate_warning": 0.05,
    "version_conflict_rate_warning": 0.2,
    "slow_p95_ms": 2500,
    "min_events_for_rates": 20,
    "retry_repeated_attempts": 3,
    "backup_max_age_hours": 26,
    "backup_warn_age_hours": 24,
    "journal_unresolved_minutes": 10,
    "stale_open_session_hours": 16,
    "kiosk_auth_rejections_warning": 20
  },
  "retry": {
    "retryable": ["TIMEOUT", "NETWORK", "UPSTREAM_5XX", "RETRYABLE_TIMEOUT", "DB_UNAVAILABLE", "AUTH_UNAVAILABLE", "UNKNOWN_OUTCOME"],
    "max_attempts": 4, "base_delay_ms": 200, "max_delay_ms": 3000, "circuit_failures": 5, "circuit_cooldown_ms": 30000
  },
  "client_vocabulary": {
    "operations": ["clock.CLOCK_IN", "clock.BREAK_START", "clock.BREAK_END", "clock.CLOCK_OUT", "kiosk.authenticate",
      "kiosk.clock.CLOCK_IN", "kiosk.clock.BREAK_START", "kiosk.clock.BREAK_END", "kiosk.clock.CLOCK_OUT",
      "kiosk.provision", "kiosk.revoke", "kiosk.reset", "export.link", "auth.sign_in", "select",
      "rpc.get_employee_state", "rpc.get_effective_timeline", "rpc.get_own_evidence", "rpc.submit_correction",
      "rpc.decide_correction", "rpc.request_export", "rpc.manage_employee", "rpc.manage_membership",
      "rpc.transfer_ownership", "rpc.create_invitation", "rpc.accept_invitation", "rpc.create_work_policy",
      "rpc.assign_work_policy", "rpc.classify_hours", "rpc.record_evidence_delivery", "rpc.authorize_export_link", "rpc.other"],
    "outcomes": ["success", "failure", "timeout", "unknown", "rejected"],
    "error_classes": ["NONE", "VERSION_CONFLICT", "IDEMPOTENCY_CONFLICT", "ALREADY_DECIDED", "CLOCK_REGRESSION", "POLICY_REQUIRED",
      "INVALID_TRANSITION", "INVALID_INPUT", "INVALID_TIMEZONE", "INVALID_TIMELINE", "INVALID_ORDINAL", "FUTURE_TIME",
      "POLICY_BACKDATE", "HOURS_MISMATCH", "INCOMPLETE_PERIOD", "LAST_OWNER", "FORBIDDEN", "UNAUTHENTICATED", "AUTH_FAILED",
      "RATE_LIMITED", "TIMEOUT", "NETWORK", "UPSTREAM_5XX", "RETRYABLE_TIMEOUT", "INVALID_RESPONSE"]
  }
}
