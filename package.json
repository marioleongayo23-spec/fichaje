{
  "name": "fichaje",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tsconfig.edge.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "scan:secrets": "node scripts/scan_secrets.mjs dist",
