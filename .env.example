# Public browser configuration only.
# Explicitly set to staging or production in deployments; may remain empty for local bootstrap.
VITE_DEPLOYMENT_TIER=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public same-origin paths of the server-only functions (reverse proxy); never keys.
VITE_KIOSK_GATEWAY_URL=/gateway/kiosk
VITE_EXPORT_LINK_URL=/gateway/export-link
