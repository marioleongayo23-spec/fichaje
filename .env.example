# Public browser configuration only. Both may remain empty in H0.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public same-origin paths of the server-only functions (reverse proxy); never keys.
VITE_KIOSK_GATEWAY_URL=/gateway/kiosk
VITE_EXPORT_LINK_URL=/gateway/export-link
VITE_BILLING_GATEWAY_URL=/gateway/billing
# Public feature flag only; Stripe keys remain server-side. H13 enables this only in test mode.
VITE_BILLING_ENABLED=0
