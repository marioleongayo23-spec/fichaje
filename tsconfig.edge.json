{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "WebWorker"],
    "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": []
  },
  "include": ["edge/**/*.ts", "functions/**/*.ts", "supabase/functions/_shared/ingress.ts"]
}
